{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "compose-tunnel",
  "version": "0.1.6",
  "identifier": "com.sube.compose-tunnel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "compose-tunnel",
        "width": 1180,
        "height": 760,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Sube-py/compose-tunnel/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNTBBMzc3Mzg3NDdFNDcKUldSSGZuUTRkNk5RejVlTCt2YUY1emluS29SeXQrL2tCMW16QThqVTQvRUJkdjZsMlBWTjVyL1oK"
    }
  }
}
